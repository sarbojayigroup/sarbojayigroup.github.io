<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Sarbojayi Tourism | Trusted Tour Operator</title>
<meta name="description" content="Sarbojayi Tourism — A Unit of SARBOJAYI GROUP. Domestic, international, honeymoon, group, corporate and customized tours from Kolkata across India and international destinations.">
<meta name="theme-color" content="#07142b">
<style>
:root{--navy:#07142b;--navy2:#0c2347;--blue:#1e5eff;--gold:#d9ad55;--gold2:#f1d28a;--ink:#172033;--muted:#657085;--bg:#f6f8fc;--white:#fff;--line:#e5e9f1;--shadow:0 14px 40px rgba(8,24,55,.10);--radius:20px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:system-ui,-apple-system,"Segoe UI","Noto Sans Bengali",Arial,sans-serif;color:var(--ink);background:var(--bg);line-height:1.6}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button{cursor:pointer}
#topbar{position:fixed;top:0;left:0;right:0;height:42px;background:rgba(4,13,29,.96);color:#fff;z-index:1000;display:flex;align-items:center;justify-content:space-between;padding:0 18px;font-size:13px;border-bottom:1px solid rgba(255,255,255,.10)}
#liveClock{letter-spacing:.2px}.lang-switch{display:flex;gap:4px;background:rgba(255,255,255,.10);padding:3px;border-radius:999px}.lang-switch button{border:0;background:transparent;color:#fff;padding:4px 11px;border-radius:999px;font-size:12px}.lang-switch button.active{background:#fff;color:var(--navy);font-weight:700}
#brandbar{position:fixed;top:42px;left:0;right:0;z-index:999;height:116px;background:linear-gradient(135deg,#fff 0%,#f7fbff 55%,#eef4ff 100%);display:flex;align-items:center;justify-content:center;overflow:hidden;border-bottom:1px solid rgba(10,32,70,.10);box-shadow:0 5px 25px rgba(0,0,0,.07)}
#brandbar:before,#brandbar:after{content:"";position:absolute;border-radius:50%;filter:blur(2px);opacity:.45;animation:floatGlow 8s ease-in-out infinite}#brandbar:before{width:250px;height:250px;background:radial-gradient(circle,rgba(30,94,255,.16),transparent 68%);left:8%;top:-120px}#brandbar:after{width:280px;height:280px;background:radial-gradient(circle,rgba(217,173,85,.18),transparent 68%);right:8%;bottom:-160px;animation-delay:-3s}@keyframes floatGlow{50%{transform:translateY(18px) scale(1.05)}}
#brandLogo{position:relative;z-index:2;width:min(700px,78vw);max-height:100px;object-fit:contain}
main{padding-top:158px}section{padding:72px 18px;scroll-margin-top:165px}.container{max-width:1180px;margin:auto}.hero{min-height:520px;display:flex;align-items:center;background:radial-gradient(circle at 85% 20%,rgba(30,94,255,.16),transparent 35%),linear-gradient(135deg,#07142b 0%,#0c2347 55%,#102f5d 100%);color:#fff;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;inset:auto -10% -55% -10%;height:260px;background:rgba(255,255,255,.05);transform:rotate(-4deg)}.hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center;position:relative;z-index:2}.eyebrow{color:var(--gold2);font-weight:800;letter-spacing:1.5px;text-transform:uppercase;font-size:13px}h1{font-size:clamp(38px,6vw,70px);line-height:1.05;margin:12px 0 18px}h2{font-size:clamp(28px,4vw,42px);line-height:1.15;margin:0 0 14px}h3{margin:0 0 8px}.hero p{font-size:18px;color:#dfe8f7;max-width:650px}.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.btn{border:0;border-radius:999px;padding:12px 20px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:8px}.primary{background:var(--gold);color:#17130a}.secondary{background:#fff;color:var(--navy)}.outline{background:transparent;border:1px solid rgba(255,255,255,.35);color:#fff}
.quick-box{background:#fff;color:var(--ink);padding:24px;border-radius:24px;box-shadow:0 20px 50px rgba(0,0,0,.18)}.quick-box h3{font-size:20px}.search-row{display:flex;gap:8px;margin:12px 0}.search-row input{flex:1;min-width:0;border:1px solid var(--line);border-radius:12px;padding:13px 14px;outline:none}.search-row button{background:var(--blue);color:#fff;border:0;border-radius:12px;padding:0 17px;font-weight:800}.chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.chip{border:1px solid var(--line);background:#f7f9fc;border-radius:999px;padding:6px 10px;font-size:12px;cursor:pointer}.results{margin-top:10px;max-height:210px;overflow:auto}.result{padding:10px 4px;border-bottom:1px solid var(--line);cursor:pointer}.result small{color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow)}.card:hover{transform:translateY(-2px);transition:.2s}.muted{color:var(--muted)}.center{text-align:center}.section-head{max-width:760px;margin:0 auto 34px;text-align:center}.gold{color:#a97818}
.interests .card{text-align:center;cursor:pointer}.icon{font-size:34px;margin-bottom:8px}.interest-selected{outline:3px solid rgba(30,94,255,.16);border-color:var(--blue)}
.service-card{min-height:170px}.service-card h3{font-size:20px}.service-card p{color:var(--muted)}
.region-tabs{display:flex;justify-content:center;gap:8px;margin-bottom:25px}.tab{border:1px solid var(--line);background:#fff;border-radius:999px;padding:9px 18px;font-weight:800}.tab.active{background:var(--navy);color:#fff}.region-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.region{padding:22px;border-radius:18px;background:linear-gradient(145deg,#fff,#f1f6ff);border:1px solid var(--line)}.region strong{display:block;font-size:18px}.place-list{color:var(--muted);font-size:14px;margin-top:7px}
.plan{background:#07142b;color:#fff}.plan .card{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.12);color:#fff;box-shadow:none}.plan label{display:block;font-weight:700;font-size:13px;margin-bottom:5px}.plan select,.plan input,.plan textarea{width:100%;padding:12px;border:1px solid rgba(255,255,255,.16);border-radius:10px;background:#fff;color:#172033}
.steps{counter-reset:step}.step{position:relative;padding-left:68px}.step:before{counter-increment:step;content:counter(step);position:absolute;left:0;top:0;width:46px;height:46px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:900}
.leaders{grid-template-columns:repeat(2,1fr)}.leader{display:grid;grid-template-columns:150px 1fr;gap:22px;align-items:center}.leader img{width:150px;height:150px;object-fit:cover;border-radius:50%;border:5px solid #fff;box-shadow:0 8px 24px rgba(0,0,0,.12)}
.faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin:10px 0}.faq summary{font-weight:800;cursor:pointer}.form{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.form .full{grid-column:1/-1}.form label{font-weight:700;font-size:13px}.form input,.form select,.form textarea{width:100%;border:1px solid var(--line);border-radius:11px;padding:12px;margin-top:5px;background:#fff}.form textarea{min-height:120px;resize:vertical}
footer{background:#040d1d;color:#dce6f6;padding:55px 18px 25px}.footer-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;gap:30px}footer h3,footer h4{color:#fff}footer a{display:block;color:#bdc9da;margin:7px 0}.copyright{border-top:1px solid rgba(255,255,255,.10);margin-top:30px;padding-top:18px;text-align:center;color:#98a6bb;font-size:13px}
.float-actions{position:fixed;right:16px;bottom:18px;z-index:1001;display:flex;flex-direction:column;gap:10px}.float-btn{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:22px;box-shadow:0 8px 22px rgba(0,0,0,.25);border:2px solid #fff}.call{background:#1e5eff}.wa{background:#159447}
#welcome{position:fixed;inset:0;background:rgba(3,10,24,.72);backdrop-filter:blur(5px);z-index:2000;display:none;align-items:center;justify-content:center;padding:18px}.modal{background:#fff;border-radius:24px;max-width:760px;width:100%;padding:28px;box-shadow:0 25px 80px rgba(0,0,0,.35);position:relative}.close{position:absolute;right:14px;top:12px;border:0;background:#f1f4f8;width:34px;height:34px;border-radius:50%}.modal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.modal-option{border:1px solid var(--line);background:#f9fbff;border-radius:14px;padding:16px;text-align:center;font-weight:800}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(100px);background:#07142b;color:#fff;padding:12px 18px;border-radius:999px;z-index:3000;opacity:0;transition:.3s}.toast.show{transform:translateX(-50%) translateY(0);opacity:1}
@media(max-width:900px){.hero-grid,.grid,.region-grid,.footer-grid{grid-template-columns:1fr 1fr}.leader{grid-template-columns:110px 1fr}.leader img{width:110px;height:110px}}
@media(max-width:650px){#topbar{height:38px;padding:0 10px;font-size:11px}#brandbar{top:38px;height:82px}#brandLogo{width:82vw;max-height:70px}main{padding-top:120px}section{padding:55px 14px;scroll-margin-top:125px}.hero{min-height:auto;padding-top:50px;padding-bottom:55px}.hero-grid,.grid,.region-grid,.footer-grid,.leaders,.form{grid-template-columns:1fr}.modal-grid{grid-template-columns:1fr 1fr}.leader{grid-template-columns:90px 1fr}.leader img{width:90px;height:90px}h1{font-size:42px}.search-row button{padding:0 13px}.float-actions{right:10px;bottom:12px}.float-btn{width:48px;height:48px}}
</style>
</head>
<body>
<div id="topbar"><div>🕒 <span id="liveClock">Loading…</span></div><div class="lang-switch"><button id="enBtn" class="active" onclick="setLang('en')">English</button><button id="bnBtn" onclick="setLang('bn')">বাংলা</button></div></div>
<header id="brandbar"><img id="brandLogo" src="assets/image-1.png" alt="Sarbojayi Tourism Logo"></header>
<main>
<section class="hero"><div class="container hero-grid"><div><div class="eyebrow" data-i18n="eyebrow">SARBOJAYI TOURISM • A UNIT OF SARBOJAYI GROUP</div><h1 data-i18n="heroTitle">Explore More. Travel Better.</h1><p data-i18n="heroText">Thoughtfully planned domestic, international, honeymoon, group, corporate and customized journeys from Kolkata.</p><div class="btns"><a class="btn primary" href="#destinations" data-i18n="explore">Explore Destinations</a><a class="btn secondary" href="#quote" data-i18n="planTrip">Plan My Trip</a><a class="btn outline" href="https://wa.me/918100360030?text=Hello%20Sarbojayi%20Tourism%2C%20I%20am%20interested%20in%20planning%20a%20tour." target="_blank" data-i18n="whatsapp">WhatsApp Us</a></div></div>
<div class="quick-box"><h3>🔎 <span data-i18n="quickSearch">Quick Search</span></h3><div class="search-row"><input id="searchInput" type="search" placeholder="Search destination or tour…" oninput="quickSearch(this.value)" data-placeholder="searchPlaceholder"><button onclick="quickSearch(document.getElementById('searchInput').value)" data-i18n="search">Search</button></div><div class="chips"><span class="chip" onclick="pickSearch('Kashmir')">Kashmir</span><span class="chip" onclick="pickSearch('Sittong')">Sittong</span><span class="chip" onclick="pickSearch('Sikkim')">Sikkim</span><span class="chip" onclick="pickSearch('Manali')">Manali</span><span class="chip" onclick="pickSearch('Andaman')">Andaman</span><span class="chip" onclick="pickSearch('Honeymoon')">Honeymoon</span></div><div id="searchResults" class="results"></div></div></div></section>

<section class="interests"><div class="container"><div class="section-head"><div class="eyebrow gold">TRAVEL INTEREST</div><h2 data-i18n="interestTitle">What are you interested in?</h2><p class="muted" data-i18n="interestText">Choose an option and we’ll shape the next step around your travel need.</p></div><div class="grid" id="interestGrid"></div></div></section>

<section><div class="container"><div class="section-head"><div class="eyebrow gold">SERVICES</div><h2 data-i18n="servicesTitle">Travel Services</h2><p class="muted" data-i18n="servicesText">Flexible travel planning for individuals, couples, families, groups and businesses.</p></div><div class="grid" id="servicesGrid"></div></div></section>

<section id="destinations"><div class="container"><div class="section-head"><div class="eyebrow gold">DESTINATIONS</div><h2 data-i18n="destTitle">Explore India & the World</h2><p class="muted" data-i18n="destText">Explore by region, then discover individual destinations and offbeat places.</p></div><div class="region-tabs"><button class="tab active" id="indiaTab" onclick="showRegions('india')">🇮🇳 India</button><button class="tab" id="intlTab" onclick="showRegions('intl')">🌍 International</button></div><div class="region-grid" id="regionGrid"></div></div></section>

<section><div class="container"><div class="section-head"><div class="eyebrow gold">TRAVEL IDEAS</div><h2 data-i18n="experienceTitle">Find Your Kind of Journey</h2></div><div class="grid" id="experienceGrid"></div></div></section>

<section><div class="container"><div class="section-head"><div class="eyebrow gold">BEST TIME</div><h2 data-i18n="bestTitle">Best Time to Visit</h2><p class="muted" data-i18n="bestText">Seasonal guidance helps you choose the right destination for your travel window.</p></div><div class="grid"><div class="card"><h3>🏔️ Kashmir</h3><p><b>Mar–Jun:</b> spring & summer experiences<br><b>Dec–Feb:</b> winter / snow experiences<br><b>Sep–Nov:</b> pleasant autumn travel</p></div><div class="card"><h3>🌿 North Bengal</h3><p><b>Oct–May:</b> popular for hills and offbeat stays<br><b>Monsoon:</b> choose carefully based on route and weather</p></div><div class="card"><h3>🏝️ Andaman</h3><p><b>Oct–May:</b> generally preferred for beach holidays and island activities.</p></div></div></div></section>

<section class="plan" id="quote"><div class="container"><div class="section-head"><div class="eyebrow">PLAN YOUR TRIP</div><h2 data-i18n="planTitle">Tell Us What You Have in Mind</h2><p data-i18n="planText">Share a few details. Your enquiry will open a WhatsApp conversation with the information filled in.</p></div><form class="form" onsubmit="submitQuote(event)"><div><label data-i18n="name">Name</label><input id="qName" required></div><div><label data-i18n="mobile">Mobile / WhatsApp</label><input id="qMobile" required inputmode="tel"></div><div><label data-i18n="destination">Destination</label><input id="qDest" placeholder="e.g. Kashmir / Sittong"></div><div><label data-i18n="travelDate">Travel Date</label><input id="qDate" type="date"></div><div><label data-i18n="travellers">Travellers</label><input id="qTravellers" type="number" min="1" value="2"></div><div><label data-i18n="tourType">Tour Type</label><select id="qType"><option>Domestic Tour</option><option>International Tour</option><option>Personal Tour</option><option>Honeymoon Tour</option><option>Family / Group Tour</option><option>Customized Tour</option></select></div><div><label data-i18n="budget">Approximate Budget</label><input id="qBudget" placeholder="Optional"></div><div><label data-i18n="callback">Preferred Contact</label><select id="qContact"><option>WhatsApp</option><option>Phone Call</option></select></div><div class="full"><label data-i18n="message">Message</label><textarea id="qMessage" placeholder="Tell us your requirements…"></textarea></div><div class="full"><button class="btn primary" type="submit" data-i18n="getQuote">Get My Quote</button></div></form></div></section>

<section><div class="container"><div class="section-head"><div class="eyebrow gold">HOW IT WORKS</div><h2 data-i18n="howTitle">Your Journey, Step by Step</h2></div><div class="grid steps"><div class="card step"><h3>Tell Us Your Plan</h3><p class="muted">Destination, date, travellers and preferences.</p></div><div class="card step"><h3>We Design Your Trip</h3><p class="muted">A practical itinerary based on your requirements.</p></div><div class="card step"><h3>Review & Customize</h3><p class="muted">Request changes before you confirm.</p></div><div class="card step"><h3>Confirm & Travel</h3><p class="muted">Booking coordination and travel support.</p></div></div></div></section>

<section><div class="container"><div class="section-head"><div class="eyebrow gold">WHY SARBOJAYI</div><h2 data-i18n="whyTitle">Why Travel With Sarbojayi?</h2></div><div class="grid"><div class="card"><h3>Personalized Planning</h3><p class="muted">Travel plans shaped around your requirements.</p></div><div class="card"><h3>Transparent Communication</h3><p class="muted">Important trip information is communicated clearly.</p></div><div class="card"><h3>Dedicated Support</h3><p class="muted">Assistance before and during your journey.</p></div><div class="card"><h3>Flexible Travel Options</h3><p class="muted">Family, couple, group, corporate and customized travel.</p></div><div class="card"><h3>One Travel Partner</h3><p class="muted">Coordination across itinerary, stay and transport requirements.</p></div><div class="card"><h3>Pan India & International</h3><p class="muted">Domestic and international travel planning from one place.</p></div></div></div></section>

<section><div class="container"><div class="section-head"><div class="eyebrow gold">LEADERSHIP</div><h2 data-i18n="leadTitle">Our Leadership</h2></div><div class="grid leaders"><div class="card leader"><img src="assets/image-2.webp" alt="Amar Das - Founder & Director"><div><h3>Amar Das</h3><b>Founder & Director</b><p class="muted">Leadership and strategic direction for Sarbojayi Tourism and SARBOJAYI GROUP.</p></div></div><div class="card leader"><img src="assets/image-3.webp" alt="Puja Naskar - Director"><div><h3>Puja Naskar</h3><b>Director</b><p class="muted">Director-level support for the organization and tourism business operations.</p></div></div></div></div></section>

<section><div class="container"><div class="section-head"><div class="eyebrow gold">TRAVEL SUPPORT</div><h2>Before, During & After Your Journey</h2></div><div class="grid"><div class="card"><h3>Before Travel</h3><p class="muted">Itinerary assistance, hotel/transport coordination and travel information.</p></div><div class="card"><h3>During Travel</h3><p class="muted">Coordination and assistance through the journey.</p></div><div class="card"><h3>After Travel</h3><p class="muted">Feedback, reviews and support for future travel planning.</p></div></div></div></section>

<section class="faq"><div class="container"><div class="section-head"><div class="eyebrow gold">FAQ</div><h2>Frequently Asked Questions</h2></div><details><summary>Can I customize my tour?</summary><p>Yes. Customized tour planning is one of the available service options.</p></details><details><summary>Do you arrange hotels and transportation?</summary><p>Tour planning can include stay and transport coordination based on the selected itinerary and booking requirements.</p></details><details><summary>Can I book a family or group tour?</summary><p>Yes. Family, group and corporate travel enquiries are supported.</p></details><details><summary>How can I make a payment?</summary><p>Online payment can be connected through a secure payment gateway. Card details, CVV and UPI PIN should never be stored by this website.</p></details><details><summary>How do I contact Sarbojayi Tourism?</summary><p>Call or WhatsApp 8100360030. Office: 033-35764303. Emergency support: 8013967348.</p></details></div></section>

<section><div class="container"><div class="section-head"><div class="eyebrow gold">ABOUT</div><h2>SARBOJAYI GROUP & SARBOJAYI TOURISM</h2></div><div class="card"><h3>SARBOJAYI GROUP</h3><p class="muted">Parent Organization</p><h3>Sarbojayi Tourism</h3><p>A tourism business unit of SARBOJAYI GROUP, offering domestic, international, group, honeymoon, corporate and customized travel services.</p><p class="muted"><b>Financial processing note:</b> Bookings, payments, invoices, receipts and other financial transactions relating to Sarbojayi Tourism are intended to be processed and managed under SARBOJAYI GROUP, subject to the actual legal and banking documentation.</p></div></div></section>

<section><div class="container"><div class="section-head"><div class="eyebrow gold">CONTACT</div><h2>Let’s Plan Your Journey</h2></div><div class="grid"><div class="card"><h3>📞 Call & WhatsApp</h3><p><a href="tel:+918100360030">8100360030</a></p><h3>☎️ Office</h3><p>033-35764303</p><h3>🚨 Emergency Support</h3><p>8013967348</p></div><div class="card"><h3>📧 Email</h3><p><a href="mailto:sarbojayitourism@gmail.com">sarbojayitourism@gmail.com</a></p><h3>📍 Address</h3><p>Narendra Pur, Kolkata – 700103, West Bengal</p><h3>🌐 Website</h3><p>www.sarbojayi.com</p></div><div class="card"><h3>💳 Payment</h3><p class="muted">Secure online payment gateway can be connected for UPI, cards, net banking and other supported methods. No sensitive banking credentials are stored by this static site.</p></div></div></div></section>
</main>
<footer><div class="container footer-grid"><div><h3>SARBOJAYI TOURISM</h3><p>A Unit of SARBOJAYI GROUP</p><p>Trusted Travel Partner for Unforgettable Journeys.</p></div><div><h4>Company</h4><a href="#destinations">Destinations</a><a href="#quote">Get a Quote</a><a href="#">About & Leadership</a><a href="#">Why Choose Us</a></div><div><h4>Travel</h4><a href="#destinations">Domestic Tours</a><a href="#destinations">International Tours</a><a href="#quote">Customized Tours</a><a href="#quote">Honeymoon Tours</a><a href="#quote">Group & Corporate Tours</a></div><div><h4>Contact</h4><a href="tel:+918100360030">8100360030</a><a href="mailto:sarbojayitourism@gmail.com">sarbojayitourism@gmail.com</a><a href="#">Privacy Policy</a><a href="#">Terms & Conditions</a><a href="#">Cancellation & Refund</a></div></div><div class="container copyright">© SARBOJAYI GROUP. All Rights Reserved. • SARBOJAYI TOURISM — A Unit of SARBOJAYI GROUP</div></footer>
<div class="float-actions"><a class="float-btn call" href="tel:+918100360030" aria-label="Call">☎</a><a class="float-btn wa" href="https://wa.me/918100360030?text=Hello%20Sarbojayi%20Tourism%2C%20I%20am%20interested%20in%20planning%20a%20tour." target="_blank" aria-label="WhatsApp">✆</a></div>
<div id="welcome"><div class="modal"><button class="close" onclick="closeWelcome()">×</button><div class="eyebrow gold">SARBOJAYI TOURISM</div><h2 data-i18n="welcomeTitle">🙏 Welcome! What are you interested in?</h2><p class="muted" data-i18n="welcomeText">Choose a travel need to start exploring.</p><div class="modal-grid" id="modalGrid"></div></div></div><div id="toast" class="toast"></div>
