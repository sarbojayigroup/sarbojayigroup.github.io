const i18n={en:{eyebrow:'SARBOJAYI TOURISM • A UNIT OF SARBOJAYI GROUP',heroTitle:'Explore More. Travel Better.',heroText:'Thoughtfully planned domestic, international, honeymoon, group, corporate and customized journeys from Kolkata.',explore:'Explore Destinations',planTrip:'Plan My Trip',whatsapp:'WhatsApp Us',quickSearch:'Quick Search',search:'Search',searchPlaceholder:'Search destination or tour…',interestTitle:'What are you interested in?',interestText:'Choose an option and we’ll shape the next step around your travel need.',servicesTitle:'Travel Services',servicesText:'Flexible travel planning for individuals, couples, families, groups and businesses.',destTitle:'Explore India & the World',destText:'Explore by region, then discover individual destinations and offbeat places.',experienceTitle:'Find Your Kind of Journey',bestTitle:'Best Time to Visit',bestText:'Seasonal guidance helps you choose the right destination for your travel window.',planTitle:'Tell Us What You Have in Mind',planText:'Share a few details. Your enquiry will open a WhatsApp conversation with the information filled in.',name:'Name',mobile:'Mobile / WhatsApp',destination:'Destination',travelDate:'Travel Date',travellers:'Travellers',tourType:'Tour Type',budget:'Approximate Budget',callback:'Preferred Contact',message:'Message',getQuote:'Get My Quote',howTitle:'Your Journey, Step by Step',whyTitle:'Why Travel With Sarbojayi?',leadTitle:'Our Leadership',welcomeTitle:'🙏 Welcome! What are you interested in?',welcomeText:'Choose a travel need to start exploring.'},bn:{eyebrow:'সার্বজয়ী ট্যুরিজম • সার্বজয়ী গ্রুপের একটি ইউনিট',heroTitle:'আরও ঘুরুন। আরও ভালোভাবে ভ্রমণ করুন।',heroText:'কলকাতা থেকে দেশীয়, আন্তর্জাতিক, হানিমুন, গ্রুপ, কর্পোরেট ও কাস্টমাইজড ভ্রমণ পরিকল্পনা।',explore:'ডেস্টিনেশন দেখুন',planTrip:'আমার ট্রিপ প্ল্যান করুন',whatsapp:'WhatsApp করুন',quickSearch:'দ্রুত খুঁজুন',search:'খুঁজুন',searchPlaceholder:'ডেস্টিনেশন বা ট্যুর লিখুন…',interestTitle:'আপনি কোন ধরনের ভ্রমণে আগ্রহী?',interestT